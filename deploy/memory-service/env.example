# 记忆服务的连接凭据。
#
# 复制到 /etc/memory-service/env，填入真实值，然后设置属主与权限：
#   sudo install -o root -g memory -m 640 env.example /etc/memory-service/env
#
# 这个文件是本机唯一保存数据库口令的地方：备份脚本也从它读取连接串。

# libpq 连接串。PG 17 集群在本机 5433 上，只监听 loopback。
MEMORY_DATABASE_URL=postgresql://memory_app:REPLACE_ME@127.0.0.1:5433/memory_svc

# provider 发送的 bearer token。用 `node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"` 生成。
MEMORY_TOKEN=REPLACE_ME

MEMORY_PORT=7180
MEMORY_HOST=127.0.0.1
