[Unit]
Description=dsh memory service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=memory
Group=memory
WorkingDirectory=/opt/memory-service
EnvironmentFile=/etc/memory-service/env
ExecStart=/usr/bin/node /opt/memory-service/server.mjs
Restart=always
RestartSec=3

# The service only needs its own directory and an outbound database socket.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryMax=512M
ReadWritePaths=/opt/memory-service

[Install]
WantedBy=multi-user.target
